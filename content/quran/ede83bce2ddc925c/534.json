{"page":534,"ayahs":[{"surah":55,"ayah":68,"text":"فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ ﱃ","tafsir":"[68] في هاتين الجنتين أنواع الفواكه ونخل ورمان.","juz":27,"originalPage":533,"originalJuz":27},{"surah":55,"ayah":69,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱄ","tafsir":"[69] فبأي نِعَم ربكما -أيها الثقلان- تكذِّبان؟","juz":27,"originalPage":533,"originalJuz":27},{"surah":55,"ayah":70,"text":"فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ ﱅ","tafsir":"[70] في هذه الجنان الأربع زوجات طيبات الأخلاق حسان الوجوه.","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":71,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱆ","tafsir":"[71] فبأي نِعَم ربكما -أيها الثقلان- تكذِّبان؟","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":72,"text":"حُورٞ مَّقۡصُورَٰتٞ فِي ٱلۡخِيَامِ ﱇ","tafsir":"[72] حور مستورات مصونات في الخيام.","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":73,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱈ","tafsir":"[73] فبأي نِعَم ربكما -أيها الثقلان- تكذِّبان؟","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":74,"text":"لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ ﱉ","tafsir":"[74] لم يطأ هؤلاء الحور إنس قبل أزواجهن ولا جان.","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":75,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱊ","tafsir":"[75] فبأي نِعَم ربكما -أيها الثقلان- تكذِّبان؟","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":76,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ ﱋ","tafsir":"[76] متكئين على وسائد ذوات أغطية خضر، وفرش بديعة فائقة الصُّنع في غاية الحُسْن.","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":77,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱌ","tafsir":"[77] فبأي نِعَم ربكما -أيها الثقلان- تكذِّبان؟","juz":27,"originalPage":534,"originalJuz":27},{"surah":55,"ayah":78,"text":"تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ﱍ","tafsir":"[78] تكاثرت بركة اسم ربك وكثر خيره، ذي الجلال الباهر، والمجد الكامل، والإكرام لأوليائه.","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":1,"text":"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ ﰀ","tafsir":"[1] إذا قامت القيامة،","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":2,"text":"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ ﰁ","tafsir":"[2]  ليس لقيامها أحد يكذِّب به،","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":3,"text":"خَافِضَةٞ رَّافِعَةٌ ﰂ","tafsir":"[3]  هي خافضة لأعداء الله في النار، رافعة لأوليائه في الجنة.","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":4,"text":"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا ﰃ","tafsir":"[4] إذا حُرِّكت الأرض تحريكاً شديداً،","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":5,"text":"وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا ﰄ","tafsir":"[5] وفُتِّتت الجبال تفتيتاً دقيقاً،","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":6,"text":"فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا ﰅ","tafsir":"[6]  فصارت غباراً متطايراً في الجو قد ذَرَتْه الريح.","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":7,"text":"وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ ﰆ","tafsir":"[7] وكنتم -أيها الخلق- أصنافاً ثلاثة:","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":8,"text":"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ﰇ","tafsir":"[8] فأصحاب اليمين أهل المنزلة العالية، ما أعظم مكانتهم!","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":9,"text":"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ﰈ","tafsir":"[9]  وأصحاب الشمال أهل المنزلة الدنيئة، ما أسوأ حالهم!","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":10,"text":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ ﰉ","tafsir":"[10] والسابقون إلى الخيرات في الدنيا هم السابقون إلى الدرجات في الآخرة، ","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":11,"text":"أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ ﰊ","tafsir":"[11]  أولئك هم المقربون عند الله،","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":12,"text":"فِي جَنَّٰتِ ٱلنَّعِيمِ ﰋ","tafsir":"[12]  يُدْخلهم ربهم في جنات النعيم.","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":13,"text":"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ﰌ","tafsir":"[13] يدخلها جماعة كثيرة من صدر هذه الأمة، وغيرهم من الأمم الأخرى،","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":14,"text":"وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ ﰍ","tafsir":"[14]  وقليل من آخر هذه الأمة","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":15,"text":"عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ ﰎ","tafsir":"[15] على سرر منسوجة بالذهب،","juz":27,"originalPage":534,"originalJuz":27},{"surah":56,"ayah":16,"text":"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ ﰏ","tafsir":"[16]  متكئين عليها يقابل بعضهم بعضاً.","juz":27,"originalPage":534,"originalJuz":27}]}
